generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native","rhel-jwt-4"]
}
datasource db {
    provider = "sqlite"
    url = env("DATABASE_URL")
}
model User {
    id         String     @id @default(uuid())
    phone      String?
    name       String
    email      String     @unique
    password   String
    image      String?
    role       String     @default("user")
    isVerified Boolean    @default(false)
    createdAt  DateTime   @default(now())
    properties Property[]
    
    comments   Comment[]
    wishlists  Wishlist[]
    transaction Transaction[]
    notification Notification []
    verificationRequests VerificationRequest?
}
model Transaction {
    id              String   @id @default(cuid())
  reference       String   @unique // لتخزين كود مثل TRX-9928#
  type            String   // "مشتري" أو "بائع" (حسب نوع الطلب اللي قدمه اليوزر)
    amount          Float
  status          String   @default("PENDING") // قيد الانتظار، موافق عليه، مرفوض
  otherPartyName  String?  
  otherPartyAddress String?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  propertyId      Int
  property        Property @relation(fields: [propertyId], references: [id])
  isIdentityVerified Boolean @default(false)
  isTitleDeedValid Boolean @default(false)
  isPriceMatched Boolean @default(false)
  isSigned Boolean @default(false)
  isContractReviewed Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  otherPartyPhone String?  // رقم الهاتف الظاهر
   
}

model Property {
    id          Int        @id @default(autoincrement())
    title       String
    description String
    price       Float
    rooms       Int       @default(0)     
    location    String
    
    type        String
    category    String
    status      String     @default("available")
    createdAt   DateTime   @default(now())
    ownerId     String
    owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    comments    Comment[]
    images      Image[]
    wishlists   Wishlist[]
    transaction Transaction[]
    area      Float? @default(0)
    bedrooms  Int @default(0)
    bathrooms Int @default(0)
    floor     String @default("الطابق")
    city      String @default("المدينة المحلية")
    region    String @default("المنطقة المحلية")
    verificationRequests VerificationRequest[]
}
model VerificationRequest {
  id          String   @id @default(cuid())
  userId      String   @unique // كل مستخدم له طلب توثيق واحد
  user        User     @relation(fields: [userId], references: [id])
  rejectedReason String?
  idType      String   // مثلاً: "هوية شخصية" أو "جواز سفر"
  idNumber    String?  // اختياري: رقم الهوية
  frontImage  String   // رابط صورة الوجه الأمامي
  backImage   String   // رابط صورة الوجه الخلفي
  propertyId  Int?
  property    Property? @relation(fields: [propertyId], references: [id])
  status      String   @default("PENDING") // الحالات: PENDING, APPROVED, REJECTED
  adminNotes  String?  // ملاحظاتك ليش رفضتي الطلب مثلاً
  propertyDoc String  @default("not_found") // رابط صك الملكية
isPriceMatched Boolean @default(false)
isSigned Boolean @default(false)
isContractReviewed Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Comment {
    id         Int      @id @default(autoincrement())
    content    String
    createdAt  DateTime @default(now())
    propertyId Int
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Image {
    id         Int      @id @default(autoincrement())
    url        String
    propertyId Int
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Wishlist {
    id         Int      @id @default(autoincrement())
    userId     String
    propertyId Int
    createdAt  DateTime @default(now())
    user       User     @relation(fields: [userId], references: [id])
    property   Property @relation(fields: [propertyId], references: [id])

    @@unique([userId, propertyId])
}
model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}